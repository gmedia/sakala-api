APP_NAME="Sakala API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.sakala.localhost:8000
SAKALA_CONSOLE_URL=http://app.sakala.localhost:5173
# Linked from every email footer for /privasi and /syarat.
SAKALA_LANDING_URL=https://sakala.dev
# Logo in every email header: absolute HTTPS URL to a 280 x 118 PNG.
SAKALA_MAIL_LOGO_URL=https://sakala.dev/email/sakala-logo@2x.png
SAKALA_API_VERSION=v1
SAKALA_PROJECT_DEFAULT_DOMAIN=run.sakala.localhost
SAKALA_PROJECT_URL_SCHEME=http
SAKALA_PROJECT_URL_PORT=
SCRAMBLE_ENABLED=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=sakala_api
DB_USERNAME=sail
DB_PASSWORD=password
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-only on purpose: a parent domain would reach tenant applications. Production
# uses __Host-sakala-api-session, which needs HTTPS. See docs/AUTHENTICATION.md.
SESSION_COOKIE=sakala-api-session
SESSION_DOMAIN=
# Only XSRF-TOKEN gets the parent domain, because the console reads it from JavaScript.
SAKALA_XSRF_COOKIE_DOMAIN=.sakala.localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=app.sakala.localhost:5173,api.sakala.localhost:8000,localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://app.sakala.localhost:5173,http://localhost:5173

SAKALA_API_RATE_LIMIT=240
SAKALA_API_GUEST_RATE_LIMIT=60
SAKALA_LOGIN_RATE_LIMIT=5
SAKALA_REGISTER_RATE_LIMIT=5
SAKALA_OAUTH_RATE_LIMIT=10
SAKALA_EMAIL_VERIFICATION_RATE_LIMIT=5
SAKALA_MAX_PROJECTS_PER_USER=3
SAKALA_MAX_ACTIVE_DEPLOYMENTS_PER_USER=2
SAKALA_MAX_ACTIVE_DEPLOYMENTS_PER_PROJECT=1
SAKALA_DEFAULT_CONTAINER_MEMORY_MB=256
SAKALA_MAX_CONTAINER_MEMORY_MB=512
SAKALA_DEFAULT_CONTAINER_CPU_MILLIS=500
SAKALA_MAX_CONTAINER_CPU_MILLIS=1000
SAKALA_DEFAULT_CONTAINER_PIDS_LIMIT=128
SAKALA_MAX_CONTAINER_PIDS_LIMIT=256
# Workspaces: teams one user may own, and invitations.
SAKALA_MAX_OWNED_TEAMS_PER_USER=2
SAKALA_WORKSPACE_INVITATION_TTL_HOURS=168
SAKALA_WORKSPACE_INVITATION_RETENTION_HOURS=168
SAKALA_WORKSPACE_INVITATION_RATE_LIMIT=20
# Team limits without a limit profile, kept small so teams do not multiply quota.
SAKALA_TEAM_MAX_PROJECTS=2
SAKALA_TEAM_MAX_ACTIVE_CONTAINERS=2
SAKALA_TEAM_MAX_ACTIVE_DEPLOYMENTS=1
SAKALA_BUILD_TIMEOUT_SECONDS=600
SAKALA_START_TIMEOUT_SECONDS=120
SAKALA_COMMAND_TIMEOUT_SECONDS=900
SAKALA_LOG_MAX_LINE_LENGTH=4096
SAKALA_LOG_MAX_BATCH_LINES=500
SAKALA_LOG_MAX_TOTAL_BYTES=10485760
SAKALA_LOG_MAX_REQUEST_BYTES=1048576
SAKALA_LOG_RETENTION_DAYS=7
# Usage signals: how long signals are kept, and repeated build failures before a signal is recorded.
SAKALA_USAGE_SIGNALS_RETENTION_DAYS=30
SAKALA_USAGE_SIGNALS_REPEAT_FAILURE_THRESHOLD=3
SAKALA_AGENT_SUPPORTED_PROTOCOL_VERSIONS=4
SAKALA_AGENT_COMMAND_BATCH_SIZE=10
SAKALA_AGENT_OFFLINE_AFTER_SECONDS=60
SAKALA_AGENT_LEASE_GRACE_SECONDS=60
SAKALA_SIMULATE_DEPLOYMENTS=false
SAKALA_FEEDBACK_RATE_LIMIT=5
SAKALA_PASSWORD_RESET_RATE_LIMIT=5
SAKALA_ACCOUNT_SECURITY_RATE_LIMIT=5
SAKALA_INSPECTION_RATE_LIMIT=5
SAKALA_NOTIFICATION_RETENTION_DAYS=90
SAKALA_DELETED_PROJECT_RETENTION_DAYS=30
# Idle sleep: minutes without a request before a running project is put to sleep
# (0 = off, the default). Needs agents with the `idle-sleep` capability.
# SAKALA_PROJECT_IDLE_SLEEP_MINUTES=30
# Wake requests per minute per visitor IP and project slug.
# SAKALA_PROJECT_WAKE_RATE_LIMIT=6

# `log` needs nothing running but gives no realtime. For realtime use `reverb`, fill
# REVERB_APP_*, and run `composer reverb` and `composer queue`.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `local` stores avatars under storage/app/public (run `php artisan storage:link`).
# Remove it, or set `s3`, to use the AWS_* bucket below.
SAKALA_AVATAR_STORAGE=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=sakala_api_cache

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sakala.localhost"
MAIL_FROM_NAME="Sakala"
# Local development stays true even with MAIL_MAILER=log, because
# sakala-infra/docs/FULL_STACK_LOCAL.md reads the links from the log. On a real
# deployment leave it unset: it is then true for an SMTP mailer and false for log
# and array, which makes the API answer 503 EMAIL_DELIVERY_UNAVAILABLE and the
# console hide email registration. See docs/CONFIGURATION.md.
SAKALA_EMAIL_DELIVERY_ENABLED=true

AUTH_VERIFICATION_EXPIRE=60

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_REDIRECT_URI=http://api.sakala.localhost:8000/auth/github/callback
GITHUB_APP_SETUP_URI=http://api.sakala.localhost:8000/auth/github/setup
GITHUB_APP_WEBHOOK_SECRET=
# Optional read-only token for public repositories. Anonymous GitHub allows only
# 60 requests per hour per server IP. Give it access to public repositories only.
GITHUB_PUBLIC_API_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://api.sakala.localhost:8000/auth/google/callback

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=app.sakala.localhost,localhost
REVERB_SCALING_ENABLED=false

AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=sakala
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

AWS_URL=http://localhost:9000/sakala

APP_PORT=8000

FORWARD_DB_PORT=5432
FORWARD_VALKEY_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_REVERB_PORT=8080

FORWARD_RUSTFS_PORT=9000
FORWARD_RUSTFS_CONSOLE_PORT=9001
