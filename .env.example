APP_NAME="Sakala API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.sakala.localhost:8000
SAKALA_CONSOLE_URL=http://app.sakala.localhost:5173
SAKALA_API_VERSION=v1
SCRAMBLE_ENABLED=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=sakala_api
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sakala.localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=app.sakala.localhost:5173,api.sakala.localhost:8000,localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://app.sakala.localhost:5173,http://localhost:5173

SAKALA_API_RATE_LIMIT=60
SAKALA_LOGIN_RATE_LIMIT=5
SAKALA_OAUTH_RATE_LIMIT=10
SAKALA_MAX_PROJECTS_PER_USER=3
SAKALA_MAX_ACTIVE_DEPLOYMENTS_PER_USER=2
SAKALA_MAX_ACTIVE_DEPLOYMENTS_PER_PROJECT=1
SAKALA_DEFAULT_CONTAINER_MEMORY_MB=256
SAKALA_MAX_CONTAINER_MEMORY_MB=512
SAKALA_DEFAULT_CONTAINER_CPU_MILLIS=500
SAKALA_MAX_CONTAINER_CPU_MILLIS=1000
SAKALA_DEFAULT_CONTAINER_PIDS_LIMIT=128
SAKALA_MAX_CONTAINER_PIDS_LIMIT=256
SAKALA_BUILD_TIMEOUT_SECONDS=600
SAKALA_START_TIMEOUT_SECONDS=120
SAKALA_COMMAND_TIMEOUT_SECONDS=900
SAKALA_LOG_MAX_LINE_LENGTH=4096
SAKALA_LOG_MAX_BATCH_LINES=500
SAKALA_LOG_MAX_TOTAL_BYTES=10485760
SAKALA_FEEDBACK_RATE_LIMIT=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=sakala_api_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sakala.localhost"
MAIL_FROM_NAME="${APP_NAME}"

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_REDIRECT_URI=http://api.sakala.localhost:8000/auth/github/callback
GITHUB_APP_SETUP_URI=http://api.sakala.localhost:8000/auth/github/setup
GITHUB_APP_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://api.sakala.localhost:8000/auth/google/callback

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://app.sakala.localhost:5173,http://localhost:5173
REVERB_SCALING_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_REVERB_PORT=8081
